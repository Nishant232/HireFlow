PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_from_supabase_dashboard_settings_api
# OpenRouter API Key (free at https://openrouter.ai/keys)
# Models used: nvidia/nemotron-3-super:free, openai/gpt-oss-120b:free, meta-llama/llama-4-scout:free
OPENROUTER_API_KEY=sk-or-v1-your-key-here
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Adzuna Jobs API (free at https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# File upload
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads/
